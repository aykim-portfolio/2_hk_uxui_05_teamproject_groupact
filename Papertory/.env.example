# ImageKit.io 설정
# https://imagekit.io/dashboard/settings/developer/api-keys 에서 확인 가능

# API 키 (프라이빗)
IMAGEKIT_PRIVATE_KEY=your_private_key_here

# 공개 API 키
IMAGEKIT_PUBLIC_KEY=your_public_key_here

# URL Endpoint
# 형식: https://ik.imagekit.io/[your-imagekit-id]
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
